# The Express API backend (default).
VITE_API_URL=http://localhost:4000

# Supabase backend. Set VITE_DATA_BACKEND=supabase to use it; the URL and the
# publishable (anon) key come from the project's API settings and ship in the
# browser bundle, which is safe only because every table has row-level security.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_DATA_BACKEND=api
